{
  "_meta": {
    "description": "Ausgabegrößen (SPEC Kap. 7) für Level 1. deps: Parametergruppen, aus denen der Status abgeleitet wird (board | board_loaded | sim | sim_flight). Größen, die Level 1 nicht liefert, haben level_min > 1.",
    "deps": {
      "board": ["board.k_tip_75", "board.m_b_75", "board.m_k", "board.delta_k_per_step", "board.fulcrum", "board.fulcrum_model", "technique.d_toes", "board.mb_exponent?", "board.span_75?", "board.overhang_75?"],
      "board_loaded": ["@board", "athlete.mass"],
      "sim": ["@board", "athlete.*", "leg.*", "activation.*", "board.zeta", "@start"],
      "sim_flight": ["@sim", "technique.v_x", "technique.entry_offset_ratio", "board.height_above_water"]
    }
  },
  "metrics": [
